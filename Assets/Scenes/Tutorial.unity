  m_Name: TutorialController
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &443849784
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 443849783}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed9c0c0d6b166dc4d9096a280c87dc47, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Luar.TutorialController
  steps:
  - title: 1. Tu puntero (Gaze)
    body: "El <b>punto blanco</b> del centro es tu puntero. Mueve la cabeza para apuntar.\n\nMira el bot\xF3n <b>Comenzar</b> sin mover la cabeza hasta llenar el anillo (o toca el bot\xF3n del visor)."
    highlight: {fileID: 0}
  - title: "2. Teletransp\xF3rtate"
    body: "Los <b>c\xEDrculos menta</b> del piso son puntos de salto.\n\nMira el c\xEDrculo de la <b>Barra de pr\xE1ctica</b> (junto a la flecha rosa) para moverte hasta all\xED."
    highlight: {fileID: 31960572}
  - title: 3. Agarra un objeto
    body: "Mira la <b>taza rosada</b> sobre la barra hasta llenar el anillo.\n\nLa taza flotar\xE1 frente a ti: la llevas contigo aunque te muevas."
    highlight: {fileID: 1762687498}
  - title: "4. Col\xF3calo"
    body: "Ahora mira el <b>plato con aro rosado</b> de la mesa de la clienta.\n\nTambi\xE9n puedes dejar objetos mirando cualquier mesa o barra."
    highlight: {fileID: 946337584}
  - title: "\xA1Lo lograste!"
    body: "Ya sabes mirar, saltar, agarrar y colocar.\n\nAhora ve al <b>Recorrido</b> y atiende a los clientes de Luar Caf\xE9."
    highlight: {fileID: 0}
  titleText: {fileID: 948717795}
  bodyText: {fileID: 1098602079}
  stepCounter: {fileID: 227357822}
  finishButtons: {fileID: 1878442475}
  startButton: {fileID: 1965924219}
